// Prisma schema for InfinityGG
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Relations
  adminProfile       AdminUser?
  whitelistApps      WhitelistApplication[]
  regulationVersions RegulationVersion[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== ADMIN & PERMISSIONS ====================

model AdminUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordId   String   @unique
  discordTag  String?
  role        AdminRole
  permissions String[] // Custom permissions beyond role
  
  active      Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  reviewedApplications WhitelistApplication[] @relation("Reviewer")
  
  @@map("admin_users")
}

enum AdminRole {
  root
  contentEditor
  InfinityGG_Team
  Whitelist_Checker
}

// ==================== REGULATIONS ====================

model RegulationVersion {
  id        Int      @id @default(autoincrement())
  content   Json     // Structured content as JSON
  version   Int
  updatedBy String
  user      User     @relation(fields: [updatedBy], references: [id])
  notes     String?  // Optional notes about changes
  createdAt DateTime @default(now())

  @@map("regulation_versions")
}

// ==================== WHITELIST ====================

model WhitelistApplication {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  discordId  String
  discordTag String
  
  answers    Json                   // Array of {questionId, answer}
  status     WhitelistStatus        @default(SENT)
  priority   Boolean                @default(false)
  
  reviewedBy String?
  reviewer   AdminUser?             @relation("Reviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?
  rejectionReason String?           @db.Text
  
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@map("whitelist_applications")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum WhitelistStatus {
  SENT
  IN_REVIEW
  APPROVED
  REJECTED
}

model WhitelistQuestion {
  id          String   @id @default(cuid())
  question    String
  questionType QuestionType @default(TEXT)
  minLength   Int?
  maxLength   Int?
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  order       Int
  options     String[] // dla type SELECT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum QuestionType {
  TEXT      // Krótki tekst
  TEXTAREA  // Długi tekst
  NUMBER    // Tylko liczby
  SELECT    // Wybór z listy
}

// ==================== SYSTEM SETTINGS ====================

model SystemSettings {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  action    String   // e.g., 'WHITELIST_APPROVED', 'USER_ROLE_CHANGED'
  target    String?  // Target ID (user, application, etc.)
  targetType String? // Type of target
  details   Json?    // Additional details
  ipAddress String?
  userAgent String?  @db.Text
  
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
