# Połączenie z PostgreSQL (wartości zgodne z docker-compose.yml)
DATABASE_URL="postgresql://infinitygg_user:bezpieczne_haslo@localhost:5432/infinitygg"

# Auth.js - wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET="zmien-na-losowy-ciag-min-32-znaki"
NEXTAUTH_URL="http://localhost:3000"
# Wymagane przy `next start` poza Vercel (zaufanie nagłówkowi Host)
AUTH_TRUST_HOST="true"

# Discord OAuth2 (Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Discord bot i serwer (role na serwerze nadawane po akceptacji podania)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_WHITELIST_ROLE_ID=""

# Webhooki powiadomień o decyzjach w sprawie podań
DISCORD_WEBHOOK_WHITELIST_APPROVED=""
DISCORD_WEBHOOK_WHITELIST_REJECTED=""
